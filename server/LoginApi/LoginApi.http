@host = http://localhost:8080

### Register a new user
POST {{host}}/api/auth/register
Content-Type: application/json

{ "username": "test", "password": "test1234" }

### Log in as a new user
POST {{host}}/api/auth/login
Content-Type: application/json

{ "username": "test", "password": "test1234" }

### Log in as admin (seeded)
POST {{host}}/api/auth/login
Content-Type: application/json

{ "username": "admin", "password": "Admin123!" }

### Wrong Password (should fail)
POST {{host}}/api/auth/login
Content-Type: application/json

{ "username": "admin", "password": "WRONG!" }

### Hent brugere uden token (skal give 401)
GET {{host}}/api/users

### Log ind som user og gem token
POST {{host}}/api/auth/login
Content-Type: application/json

{ "username": "user", "password": "User1234!" }

> {% client.global.set("token", response.body.token); %}

### Hent brugere med token (skal give liste med 3 brugere)
GET {{host}}/api/users
Authorization: Bearer {{token}}

### Som user: opret bruger (skal give 403)
POST {{host}}/api/users
Authorization: Bearer {{token}}
Content-Type: application/json

{ "username": "nytest", "password": "Test12345", "role": "user" }

### Log ind som admin og gem token
POST {{host}}/api/auth/login
Content-Type: application/json

{ "username": "admin", "password": "Admin123!" }

> {% client.global.set("token", response.body.token); %}

### Som admin: opret bruger (skal give 201)
POST {{host}}/api/users
Authorization: Bearer {{token}}
Content-Type: application/json

{ "username": "testbruger", "password": "Test12345", "role": "user" }

### Log ind som superuser og gem token
POST {{host}}/api/auth/login
Content-Type: application/json

{ "username": "superuser", "password": "Super123!" }

> {% client.global.set("token", response.body.token); %}

### Som superuser: slet admin, id 1 (skal give 403)
DELETE {{host}}/api/users/1
Authorization: Bearer {{token}}

### Som superuser: slet en almindelig bruger, id 4 (skal give 204)
DELETE {{host}}/api/users/4
Authorization: Bearer {{token}}

### Som superuser: gør user til admin (skal give 403)
PUT {{host}}/api/users/3
Authorization: Bearer {{token}}
Content-Type: application/json

{ "role": "admin" }

### Som superuser: skift navn på en almindelig bruger (skal give 204)
PUT {{host}}/api/users/4
Authorization: Bearer {{token}}
Content-Type: application/json

{ "username": "omdoebt" }